<?php

/**
 * @file
 * Einrichtung des Studios: Inhaltsart, Felder, Rollen, Datenschutz-Voreinstellung.
 *
 * Die gesamte Einrichtung steht hier als Code — nicht als Handarbeit in einer
 * Datenbank. So lässt sich die Instanz jederzeit nachbauen.
 */

use Drupal\block\Entity\Block;
use Drupal\Core\Entity\Entity\EntityFormDisplay;
use Drupal\Core\Entity\Entity\EntityViewDisplay;
use Drupal\field\Entity\FieldConfig;
use Drupal\field\Entity\FieldStorageConfig;
use Drupal\mekotools_studio\Antragsspeicher;
use Drupal\node\Entity\NodeType;
use Drupal\taxonomy\Entity\Term;
use Drupal\taxonomy\Entity\Vocabulary;
use Drupal\user\Entity\Role;

/**
 * Fächer der Startfassung. Erweiterbar: neue Fächer sind Begriffe in der
 * Sammlung „faecher" und lassen sich im Studio ergänzen.
 */
function mekotools_studio_faecher_start() {
  return [
    'Deutsch', 'Mathematik', 'Englisch', 'Sachunterricht', 'Biologie', 'Physik',
    'Chemie', 'Geschichte', 'Politik', 'Geografie', 'Musik', 'Kunst', 'Ethik',
    'Religion', 'Sport', 'Informatik', 'Medienbildung', 'Übergreifend',
  ];
}

/**
 * Legt Sammlungen, Inhaltsart und Felder an.
 */
function mekotools_studio_install() {
  // 1. Sammlungen (Schlagworte sind frei, Fächer haben einen Startbestand).
  if (!Vocabulary::load('faecher')) {
    Vocabulary::create([
      'vid' => 'faecher',
      'name' => 'Fächer',
      'description' => 'Schulfächer der H5P-Inhalte.',
    ])->save();
  }
  if (!Vocabulary::load('schlagworte')) {
    Vocabulary::create([
      'vid' => 'schlagworte',
      'name' => 'Schlagworte',
      'description' => 'Frei vergebene Stichworte; jede Lehrkraft darf neue anlegen.',
    ])->save();
  }
  foreach (mekotools_studio_faecher_start() as $name) {
    $vorhanden = \Drupal::entityTypeManager()->getStorage('taxonomy_term')
      ->loadByProperties(['vid' => 'faecher', 'name' => $name]);
    if (!$vorhanden) {
      Term::create(['vid' => 'faecher', 'name' => $name])->save();
    }
  }

  // 2. Inhaltsart.
  if (!NodeType::load('h5p_inhalt')) {
    NodeType::create([
      'type' => 'h5p_inhalt',
      'name' => 'H5P-Inhalt',
      'description' => 'Interaktive Übung (H5P), im Studio erstellt.',
      'title_label' => 'Titel',
      'new_revision' => TRUE,
      'display_submitted' => TRUE,
    ])->save();
  }

  // 3. Feld „Interaktive Übung (H5P)" — die Verknüpfung zum H5P-Bestand.
  if (!FieldStorageConfig::loadByName('node', 'field_h5p')) {
    FieldStorageConfig::create([
      'field_name' => 'field_h5p',
      'entity_type' => 'node',
      'type' => 'h5p',
      'cardinality' => 1,
    ])->save();
  }
  if (!FieldConfig::loadByName('node', 'h5p_inhalt', 'field_h5p')) {
    FieldConfig::create([
      'field_name' => 'field_h5p',
      'entity_type' => 'node',
      'bundle' => 'h5p_inhalt',
      'label' => 'Interaktive Übung (H5P)',
      'description' => 'Inhaltstyp wählen und ausfüllen. Speichern legt die Übung dauerhaft ab.',
      'required' => TRUE,
    ])->save();
  }

  // 4. Fach (ein Begriff) und Schlagworte (mehrere, frei erweiterbar).
  if (!FieldStorageConfig::loadByName('node', 'field_fach')) {
    FieldStorageConfig::create([
      'field_name' => 'field_fach',
      'entity_type' => 'node',
      'type' => 'entity_reference',
      'cardinality' => 1,
      'settings' => ['target_type' => 'taxonomy_term'],
    ])->save();
  }
  if (!FieldConfig::loadByName('node', 'h5p_inhalt', 'field_fach')) {
    FieldConfig::create([
      'field_name' => 'field_fach',
      'entity_type' => 'node',
      'bundle' => 'h5p_inhalt',
      'label' => 'Fach',
      'required' => FALSE,
      'settings' => [
        'handler' => 'default:taxonomy_term',
        'handler_settings' => [
          'target_bundles' => ['faecher' => 'faecher'],
          'auto_create' => FALSE,
        ],
      ],
    ])->save();
  }
  if (!FieldStorageConfig::loadByName('node', 'field_schlagworte')) {
    FieldStorageConfig::create([
      'field_name' => 'field_schlagworte',
      'entity_type' => 'node',
      'type' => 'entity_reference',
      'cardinality' => -1,
      'settings' => ['target_type' => 'taxonomy_term'],
    ])->save();
  }
  if (!FieldConfig::loadByName('node', 'h5p_inhalt', 'field_schlagworte')) {
    FieldConfig::create([
      'field_name' => 'field_schlagworte',
      'entity_type' => 'node',
      'bundle' => 'h5p_inhalt',
      'label' => 'Schlagworte',
      'description' => 'Ein neues Wort wird beim Speichern angelegt.',
      'required' => FALSE,
      'settings' => [
        'handler' => 'default:taxonomy_term',
        'handler_settings' => [
          'target_bundles' => ['schlagworte' => 'schlagworte'],
          'auto_create' => TRUE,
          'auto_create_bundle' => 'schlagworte',
        ],
      ],
    ])->save();
  }

  // 5. Kurzbeschreibung (nutzt das Feld, das die Grundfassung mitbringt).
  if (FieldStorageConfig::loadByName('node', 'body')
      && !FieldConfig::loadByName('node', 'h5p_inhalt', 'body')) {
    FieldConfig::create([
      'field_name' => 'body',
      'entity_type' => 'node',
      'bundle' => 'h5p_inhalt',
      'label' => 'Kurzbeschreibung',
      'required' => FALSE,
    ])->save();
  }

  // 6. Formular und Anzeige.
  $form = EntityFormDisplay::load('node.h5p_inhalt.default') ?: EntityFormDisplay::create([
    'id' => 'node.h5p_inhalt.default',
    'targetEntityType' => 'node',
    'bundle' => 'h5p_inhalt',
    'mode' => 'default',
    'status' => TRUE,
  ]);
  $form->setComponent('field_h5p', ['type' => 'h5p_editor', 'weight' => 1, 'settings' => []])
    ->setComponent('field_fach', ['type' => 'options_select', 'weight' => 2, 'settings' => []])
    ->setComponent('field_schlagworte', [
      'type' => 'entity_reference_autocomplete_tags',
      'weight' => 3,
      'settings' => [
        'match_operator' => 'CONTAINS',
        'match_limit' => 10,
        'size' => 60,
        'placeholder' => 'Schlagworte, durch Komma getrennt',
      ],
    ]);
  if (FieldConfig::loadByName('node', 'h5p_inhalt', 'body')) {
    $form->setComponent('body', [
      'type' => 'text_textarea',
      'weight' => 4,
      'settings' => ['rows' => 3, 'placeholder' => ''],
    ]);
  }
  $form->save();

  $view = EntityViewDisplay::load('node.h5p_inhalt.default') ?: EntityViewDisplay::create([
    'id' => 'node.h5p_inhalt.default',
    'targetEntityType' => 'node',
    'bundle' => 'h5p_inhalt',
    'mode' => 'default',
    'status' => TRUE,
  ]);
  $view->setComponent('field_h5p', ['type' => 'h5p_default', 'label' => 'hidden', 'weight' => 0])
    ->setComponent('body', ['type' => 'text_default', 'label' => 'hidden', 'weight' => 1])
    ->setComponent('field_fach', ['type' => 'entity_reference_label', 'label' => 'inline', 'weight' => 2])
    ->setComponent('field_schlagworte', ['type' => 'entity_reference_label', 'label' => 'inline', 'weight' => 3]);
  $view->save();

  // 7. Rollen der Stufenleiter (Rechte siehe _mekotools_studio_stufenrechte).
  mekotools_studio_stufenrechte_setzen();

  // 8. Datenschutz: die Voreinstellung des H5P-Bausteins sendet Nutzungsdaten
  // an h5p.org. Das schalten wir ab. Der Abruf des Inhaltstypen-Verzeichnisses
  // (Inhaltstypen-Auswahl) bleibt bestehen; ohne ihn gäbe es keine Auswahl.
  \Drupal::configFactory()->getEditable('h5p.settings')
    ->set('h5p_send_usage_statistics', 0)
    ->set('h5p_hub_is_enabled', 1)
    ->set('h5p_export', 1)
    ->set('h5p_embed', 1)
    ->save();

  // 9. Zugangsanträge: Tabelle, Rolle und Recht.
  mekotools_studio_sicherstellen();
}

/**
 * Tabelle der Zugangsanträge.
 */
function mekotools_studio_schema() {
  return [
    Antragsspeicher::TABELLE => [
      'description' => 'Anträge auf Zugang zum Studio, mit Zustand und Vermerk.',
      'fields' => [
        'nummer' => [
          'type' => 'serial',
          'unsigned' => TRUE,
          'not null' => TRUE,
          'description' => 'Laufende Nummer des Antrags.',
        ],
        'name' => [
          'type' => 'varchar',
          'length' => 120,
          'not null' => TRUE,
          'default' => '',
        ],
        'adresse' => [
          'type' => 'varchar',
          'length' => 180,
          'not null' => TRUE,
          'default' => '',
        ],
        'einrichtung' => [
          'type' => 'varchar',
          'length' => 160,
          'not null' => TRUE,
          'default' => '',
        ],
        'rolle' => [
          'type' => 'varchar',
          'length' => 24,
          'not null' => TRUE,
          'default' => '',
          'description' => 'Selbstauskunft: lehrkraft, fachkraft oder sonstiges.',
        ],
        'begruendung' => [
          'type' => 'text',
          'size' => 'normal',
          'not null' => FALSE,
        ],
        'zustand' => [
          'type' => 'varchar',
          'length' => 16,
          'not null' => TRUE,
          'default' => 'offen',
        ],
        'vermerk' => [
          'type' => 'varchar',
          'length' => 500,
          'not null' => TRUE,
          'default' => '',
        ],
        'konto' => [
          'type' => 'varchar',
          'length' => 64,
          'not null' => TRUE,
          'default' => '',
          'description' => 'Kennung des Kontos im Anmeldedienst.',
        ],
        'angelegt' => [
          'type' => 'int',
          'not null' => TRUE,
          'default' => 0,
        ],
        'bearbeitet' => [
          'type' => 'int',
          'not null' => TRUE,
          'default' => 0,
        ],
        'zustaendig' => [
          'type' => 'int',
          'not null' => TRUE,
          'default' => 0,
          'description' => 'Konto, das entschieden hat.',
        ],
      ],
      'primary key' => ['nummer'],
      'indexes' => [
        'zustand' => ['zustand'],
        'adresse' => ['adresse'],
      ],
    ],
  ];
}

/**
 * Sorgt dafür, dass Tabelle, Rolle und Recht vorhanden sind.
 *
 * Läuft bei der Ersteinrichtung und bei jeder Aktualisierung: eine bestehende
 * Instanz wird so nachgezogen, ohne dass jemand von Hand eingreifen muss.
 */
function mekotools_studio_sicherstellen() {
  $schema = \Drupal::database()->schema();
  if (!$schema->tableExists(Antragsspeicher::TABELLE)) {
    $schema->createTable(Antragsspeicher::TABELLE, mekotools_studio_schema()[Antragsspeicher::TABELLE]);
  }

  // Rolle „Verwaltung": sieht Anträge und gibt sie frei. Bewusst nicht an
  // „Lehrkraft" gehängt — wer unterrichtet, entscheidet nicht über Zugänge.
  $rolle = Role::load('verwaltung') ?: Role::create([
    'id' => 'verwaltung',
    'label' => 'Verwaltung',
  ]);
  $rolle->grantPermission('access content')
    ->grantPermission('access site reports')
    ->grantPermission('zugangsantraege verwalten')
    ->save();

  if ($verwaltung = Role::load('administrator')) {
    if (!$verwaltung->hasPermission('zugangsantraege verwalten')) {
      $verwaltung->grantPermission('zugangsantraege verwalten')->save();
    }
  }
}

/**
 * Nimmt die Kennung des Kontos im Anmeldedienst auf.
 */
function mekotools_studio_update_10003(&$sandbox) {
  $schema = \Drupal::database()->schema();
  $tabelle = Antragsspeicher::TABELLE;
  if ($schema->tableExists($tabelle) && !$schema->fieldExists($tabelle, 'konto')) {
    $spalten = mekotools_studio_schema()[$tabelle]['fields'];
    $schema->addField($tabelle, 'konto', $spalten['konto']);
    return 'Spalte „konto" in der Tabelle der Zugangsanträge ergänzt.';
  }
  return 'Spalte „konto" war schon vorhanden.';
}

/**
 * Legt die Rolle der Stufe 1 an.
 *
 * Stufe 1 ist „angemeldet, aber nicht bestätigt": sehen, aber nicht gestalten.
 * Wer Inhalte erstellen darf, ist Stufe 2 (Rolle Lehrkraft).
 */
function mekotools_studio_update_10002(&$sandbox) {
  $rolle = Role::load('angemeldet') ?: Role::create([
    'id' => 'angemeldet',
    'label' => 'Angemeldet (unbestätigt)',
  ]);
  foreach (['access content'] as $recht) {
    $rolle->grantPermission($recht);
  }
  $rolle->save();
  return 'Rolle „Angemeldet (unbestätigt)" für Stufe 1 eingerichtet.';
}

/**
 * Legt die Tabelle der Zugangsanträge, die Rolle „Verwaltung" und das Recht an.
 */
function mekotools_studio_update_10001(&$sandbox) {
  mekotools_studio_sicherstellen();
  return 'Tabelle der Zugangsanträge und Rolle „Verwaltung" eingerichtet.';
}

/**
 * Die Rechte je Stufe.
 *
 * Die Liste ist bewusst nach dem getrennt, was eine Stufe ZUSÄTZLICH kann;
 * beim Setzen werden die unteren Stufen mitgegeben (Leiter). Anlegen darf
 * bereits Stufe 1: H5P-Inhalte erstellen und die eigenen pflegen — auch ohne
 * Bestätigung als Lehrkraft. Stufe 2 kommt hinzu: fremde Inhalte pflegen,
 * Auswertungen über alle Inhalte, Berichte. Stufe 3 verwaltet Zugänge.
 */
function _mekotools_studio_stufenrechte() {
  return [
    'angemeldet' => [
      'access content',
      'access h5p editor',
      'create h5p_inhalt content',
      'edit own h5p_inhalt content',
      'delete own h5p_inhalt content',
      'view own unpublished content',
      'create terms in faecher',
      'create terms in schlagworte',
      'create terms in tags',
      'use text format basic_html',
      'use text format restricted_html',
      'access own h5p results',
      'copy own h5ps',
      'download own h5ps',
      'embed own h5ps',
      'create restricted h5p content types',
    ],
    'lehrkraft' => [
      'edit any h5p_inhalt content',
      'delete any h5p_inhalt content',
      'access all h5p results',
      'copy all h5ps',
      'download all h5ps',
      'embed all h5ps',
      'access site reports',
    ],
    'verwaltung' => [
      'zugangsantraege verwalten',
      'access site reports',
    ],
  ];
}

/**
 * Setzt die Rechte aller drei Rollen (wiederholbar).
 */
function mekotools_studio_stufenrechte_setzen() {
  $stufen = ['angemeldet' => 1, 'lehrkraft' => 2, 'verwaltung' => 3];
  $bezeichnung = [
    'angemeldet' => 'Angemeldet (Stufe 1)',
    'lehrkraft' => 'Fachkraft bestätigt (Stufe 2)',
    'verwaltung' => 'Verwaltung (Stufe 3)',
  ];
  $rechte = _mekotools_studio_stufenrechte();
  foreach ($stufen as $rolle_id => $nummer) {
    $rolle = Role::load($rolle_id) ?: Role::create([
      'id' => $rolle_id,
      'label' => $bezeichnung[$rolle_id],
    ]);
    $rolle->set('label', $bezeichnung[$rolle_id]);
    foreach ($rechte as $tier => $liste) {
      if ($stufen[$tier] > $nummer) {
        continue;
      }
      foreach ($liste as $recht) {
        if (!$rolle->hasPermission($recht)) {
          $rolle->grantPermission($recht);
        }
      }
    }
    $rolle->save();
  }
}

/**
 * Anlegen darf schon Stufe 1.
 *
 * Bis hierher durfte nur die Rolle „Lehrkraft" Inhalte anlegen. Auf Wunsch
 * dürfen das auch angemeldete, noch nicht bestätigte Menschen — die
 * Bestätigung entscheidet über fremde Inhalte und Auswertungen, nicht über das
 * Anlegen der eigenen.
 */
function mekotools_studio_update_10004(&$sandbox) {
  mekotools_studio_stufenrechte_setzen();
  $angemeldet = Role::load('angemeldet');
  return 'Rechte der Stufen gesetzt: Stufe 1 darf H5P-Inhalte anlegen und die eigenen pflegen ('
    . count($angemeldet->getPermissions()) . ' Rechte).';
}

/**
 * Zieht die MekoTools-Hülle an: Gerüst, Startseite, Menü, Blöcke.
 *
 * Warum als Aktualisierungsschritt und nicht von Hand: eine neu aufgebaute
 * Instanz soll dieselbe Oberfläche haben, ohne dass jemand daran denken muss.
 *
 * Der Aufruf des Studios landet in der Bibliothek — dem öffentlichen Katalog.
 * Das ist der Kern des Auftrags „seamless": wer das Studio aufruft, sieht
 * sofort die Beispiele, und der Weg zurück zu mekotools.de bleibt sichtbar.
 */
function mekotools_studio_update_10005(&$sandbox) {
  $gemeldet = [];

  // 1. Gerüst, Startseite, Name.
  //    Das Gerüst muss erst installiert sein — ein bloßer Eintrag in der
  //    Konfiguration würde auf eine unbekannte Gestaltung zeigen.
  if (!\Drupal::service('theme_handler')->themeExists('mekotools_huelle')) {
    \Drupal::service('theme_installer')->install(['mekotools_huelle']);
  }
  \Drupal::configFactory()->getEditable('system.theme')
    ->set('default', 'mekotools_huelle')
    ->save();
  \Drupal::configFactory()->getEditable('system.site')
    ->set('name', 'H5P-Studio')
    ->set('slogan', '')
    ->set('page.front', '/bibliothek')
    ->save();
  $gemeldet[] = 'Gerüst „MekoTools-Hülle" gesetzt, Startseite ist die Bibliothek.';

  // 2. Zeichen und Verknüpfung des Fensters (Favicon aus dem Gerüst).
  \Drupal::configFactory()->getEditable('mekotools_huelle.settings')
    ->set('favicon.use_default', FALSE)
    ->set('favicon.path', 'themes/custom/mekotools_huelle/favicon.png')
    ->set('logo.use_default', TRUE)
    ->save();

  // 3. Blöcke des neuen Gerüsts. Ohne gesetzten Hauptinhalt zeigt jede Seite
  //    nichts an — deshalb sind diese vier nicht optional. Die Einstellungen
  //    werden von den vorhandenen Blöcken desselben Typs übernommen, damit
  //    z. B. die Menütiefe stimmt.
  //
  //    Vorher fliegt auf, was Drupal beim Installieren eines Gerüsts von selbst
  //    anlegt: eine eigene Blockordnung mit „Angetrieben von Drupal", doppelter
  //    Marke und Hilfe-Block, alle in den ersten Bereich geschoben. Am
  //    09.10.2026 genau so im Behälter gesehen. Gewünscht ist eine bestimmte
  //    Ordnung, nicht Drupals Vorschlag.
  $vorlagen = [];
  foreach (Block::loadMultiple() as $vorhanden) {
    $vorlagen[$vorhanden->getPluginId()] = $vorhanden;
  }
  $gewuenscht = [
    'mekotools_huelle_page_title' => ['page_title_block', 'content', -10],
    'mekotools_huelle_content' => ['system_main_block', 'content', 0],
    'mekotools_huelle_messages' => ['system_messages_block', 'hinweise', 0],
    'mekotools_huelle_breadcrumbs' => ['system_breadcrumb_block', 'hinweise', 1],
    'mekotools_huelle_main_menu' => ['system_menu_block:main', 'kopf_navigation', 0],
  ];
  $entfernt = 0;
  $blockspeicher = \Drupal::entityTypeManager()->getStorage('block');
  foreach ($blockspeicher->loadByProperties(['theme' => 'mekotools_huelle']) as $alt) {
    if (!isset($gewuenscht[$alt->id()])) {
      $alt->delete();
      $entfernt++;
    }
  }
  $gesetzt = 0;
  foreach ($gewuenscht as $id => [$plugin, $region, $gewicht]) {
    if (!isset($vorlagen[$plugin])) {
      continue;
    }
    $block = Block::load($id) ?: Block::create([
      'id' => $id,
      'theme' => 'mekotools_huelle',
      'plugin' => $plugin,
      'settings' => $vorlagen[$plugin]->get('settings'),
      'visibility' => $vorlagen[$plugin]->get('visibility'),
    ]);
    $block->set('region', $region)->set('weight', $gewicht)->save();
    $gesetzt++;
  }
  $gemeldet[] = $gesetzt . ' Blöcke im neuen Gerüst gesetzt, ' . $entfernt . ' Drupal-Standardblöcke entfernt.';

  // 4. Hauptmenü: „Bibliothek" statt „Startseite", Rückweg zum Katalog.
  //    Alte Verweise auf die (nun leer gelaufene) Startseite fliegen raus —
  //    die Startseite IST die Bibliothek, ein zweiter Eintrag wäre irreführend.
  $speicher = \Drupal::entityTypeManager()->getStorage('menu_link_content');
  $vorhanden = $speicher->loadByProperties(['menu_name' => 'main']);
  $entfernt = 0;
  foreach ($vorhanden as $verweis) {
    $ziel = $verweis->get('link')->first()->getValue()['uri'] ?? '';
    if (in_array($ziel, ['internal:/node', 'internal:/', 'route:<front>', '<front>'], TRUE)) {
      $beschriftung = (string) $verweis->label();
      $verweis->delete();
      $entfernt++;
      $gemeldet[] = 'Menüverweis „' . $beschriftung . '" entfernt (die Startseite ist die Bibliothek).';
    }
  }

  $zu_setzen = [
    'Bibliothek' => ['internal:/bibliothek', 0],
    'Werkzeugkatalog' => ['https://mekotools.de/katalog/', 20],
  ];
  foreach ($zu_setzen as $titel => [$ziel, $gewicht]) {
    $schon_da = FALSE;
    foreach ($speicher->loadByProperties(['menu_name' => 'main']) as $verweis) {
      if ($verweis->label() === $titel) {
        $schon_da = TRUE;
      }
    }
    if (!$schon_da) {
      $speicher->create([
        'title' => $titel,
        'link' => ['uri' => $ziel],
        'menu_name' => 'main',
        'weight' => $gewicht,
        'expanded' => FALSE,
      ])->save();
      $gemeldet[] = 'Menüverweis „' . $titel . '" angelegt.';
    }
  }

  $gemeldet[] = 'Fertig: ' . implode(' ', $gemeldet);
  return implode(' ', $gemeldet);
}
