# Vorlage für /poolio/docker/mekotools-studio/.env auf flip — Rechte 600.
# Die Werte stehen NUR dort, nie im Repo und nie im Chat.

# --- Datenbank (Passwörter erzeugen, nicht erfinden: openssl rand -hex 24) ---
STUDIO_DB_NAME=studio
STUDIO_DB_USER=studio
STUDIO_DB_PASS=
STUDIO_DB_ROOT_PASS=
STUDIO_DB_HOST=mekotools-studio-db

# --- Öffentliche Adresse der Instanz ---
STUDIO_BASIS_URL=https://studio.mekotools.de

# --- Notfallkonto (lokale Anmeldung, falls der Anmeldedienst ausfällt) ---
STUDIO_ADMIN_NAME=notfall
STUDIO_ADMIN_MAIL=
STUDIO_ADMIN_PASS=

# --- Anmeldung über Pocket ID (OIDC) ---
# Kennung und Geheimnis entstehen beim Anlegen des Anmeldekunden im Anmeldedienst
# (Verwaltungsschnittstelle, POST /api/oidc/clients). Rückleitung, die dort
# eingetragen sein muss: https://studio.mekotools.de/openid-connect/pocketid
STUDIO_OIDC_KENNUNG=
STUDIO_OIDC_GEHEIM=
STUDIO_OIDC_ISSUER=https://auth.mekotools.de
# Gruppe im Anmeldedienst, deren Mitglieder hier die Rolle Lehrkraft erhalten.
# Achtung: Schreibweise muss zum Merkmal "groups" passen.
STUDIO_OIDC_GRUPPE=lehrkraefte
# Gruppe, deren Mitglieder hier die Rolle „Verwaltung" erhalten — sie dürfen
# Zugangsanträge einsehen und freigeben.
STUDIO_OIDC_GRUPPE_VERWALTUNG=verwaltung

# --- Freigabeseite: Zugang zum Anmeldedienst ---
# Verwaltungsschlüssel aus Pocket ID (Verwaltungsschlüssel). Damit legt die
# Freigabeseite Konten an und lässt die Einladung verschicken. Fehlt er, sagt
# die Seite das offen — es scheitert nichts still.
STUDIO_POCKETID_BASIS=https://auth.mekotools.de
STUDIO_POCKETID_SCHLUESSEL=

# --- Vertrauensbereich des Vermittlers (Netz coolify) ---
STUDIO_PROXY_NETZ=10.0.1.0/24
